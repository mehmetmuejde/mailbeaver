{
  "name": "mailbeaver",
  "private": true,
  "version": "0.1.0",
  "description": "Catches outgoing mail during development and shows it like a mail client",
  "author": "Mehmet Müjde <muejde.mehmet@gmail.com> (https://github.com/mehmetmuejde)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehmetmuejde/mailbeaver.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "arch": "steiger ./src",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "release:version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "1.170.42",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.55.0",
    "radix-ui": "1.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "knip": "6.41.0",
    "shadcn": "4.22.0",
    "steiger": "0.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.11.2"
}
